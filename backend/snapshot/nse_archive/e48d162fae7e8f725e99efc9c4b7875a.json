[{"id": "106856325", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-11-12T11:57:20", "nse_category": "Analysts/Institutional Investor Meet/Con. Call Updates", "text": "Maruti Suzuki India Limited has informed the Exchange about Schedule of meet", "url": "https://nsearchives.nseindia.in/corporate/MARUTIASHISH_12112026115520_Investor_Meeting_17_18_19Nov2026.pdf", "file_size": "323.00 KB", "nse_summary": "Maruti Suzuki India Limited has scheduled investor meetings for 17th, 18th, and 19th November 2026. The company informed the National Stock Exchange of India Limited and BSE Limited pursuant to Regulation 30(6) of the SEBI Listing Obligations and Disclosure Requirements Regulations, 2015. The announcement notes that the dates are subject to change due to exigencies. Sanjeev Grover, Executive Officer and Company Secretary, signed the communication on behalf of the company."}, {"id": "106854012", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-11-10T11:56:00", "nse_category": "General Updates", "text": "Maruti Suzuki India Limited has informed the Exchange about Reference to the Financial Results issued by Suzuki Motor Corporation", "url": "https://nsearchives.nseindia.in/corporate/MARUTIASHISH_10112026115416_STxIntimation_SMCResults_FirstHalfYr_10Nov2026.pdf", "file_size": "1.55 MB", "nse_summary": "Maruti Suzuki India Limited filed a reference to the Financial Results for the first six months of FY 2026 issued by Suzuki Motor Corporation in Japan on 10th November 2026. Suzuki Motor Corporation reported consolidated revenue of 1,466.5 billion yen for the period, an increase of 16.8 percent year-on-year. Operating profit was 134.3 billion yen, a decrease of 0.6 percent. Profit before tax stood at 156.5 billion yen, down 24.5 percent. Profit attributable to owners of parent was 90.8 billion yen, a decline of 22.8 percent. The company noted increased revenue but decreased profit. Foreign exchange rates and raw material prices were cited as external factors affecting results. Capital expenditures were 87.3 billion yen. Interest-bearing debt balance was 736.0 billion yen. Cash balance was 930.0 billion yen. The filing was submitted by Sanjeev Grover, Executive Officer and Company Secretary."}, {"id": "106840686", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-11-02T21:08:18", "nse_category": "Analysts/Institutional Investor Meet/Con. Call Updates", "text": "Maruti Suzuki India Limited has informed the Exchange about Transcript", "url": "https://nsearchives.nseindia.in/corporate/MARUTIASHISH_02112026210459_Transcript_27Oct026.pdf", "file_size": "334.10 KB", "nse_summary": null}, {"id": "106838789", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-11-01T14:44:18", "nse_category": "General Updates", "text": "Maruti Suzuki India Limited has informed the Exchange about Maruti Suzuki Production Volume: October 2026", "url": "https://nsearchives.nseindia.in/corporate/MARUTIASHISH_01112026143647_STxIntimation_Prod_Oct2026.pdf", "file_size": "363.57 KB", "nse_summary": null}, {"id": "106838779", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-11-01T13:45:06", "nse_category": "Press Release", "text": "Maruti Suzuki India Limited has informed the Exchange regarding a press release dated November 01, 2026, titled \"Maruti Suzuki sales in October 2026\".", "url": "https://nsearchives.nseindia.in/corporate/MARUTIASHISH_01112026133641_StxIntimation_Sales_Oct2026.pdf", "file_size": "376.53 KB", "nse_summary": null}, {"id": "106833712", "symbol": "MARUTI", "company": "Maruti Suzuki India Limited", "industry": "Automobiles - 4 Wheelers", "time": "2026-10-29T10:50:48", "nse_category": "Press Release", "text": "Maruti S