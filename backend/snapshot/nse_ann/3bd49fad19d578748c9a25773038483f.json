[{"id": "106859832", "symbol": "HINDUNILVR", "company": "Hindustan Unilever Limited", "industry": "Diversified", "time": "2026-11-13T20:33:18", "nse_category": "Shareholders meeting", "text": "Notice of Postal Ballot for revision in overall limits of commission payable to Non-Executive Directors", "url": "https://nsearchives.nseindia.in/corporate/HINDUNILVR_13112026203221_SEIntimationPBNoticemergedsigned.pdf", "file_size": "628.27 KB", "nse_summary": "Hindustan Unilever Limited has issued a notice for a postal ballot regarding the revision of overall limits of commission payable to Non-Executive Directors. The resolution is an ordinary resolution proposed for consideration by members. The e-voting period commences at 09:00 A.M. on Wednesday, 18th November, 2026, and ends at 05:00 P.M. on Thursday, 17th December, 2026. The cut-off date for determining eligibility is Friday, 6th November, 2026. The resolution seeks authorization to pay commission not exceeding 1% of net profits or Rs. 15 crore per annum, whichever is lower, for the period from 1st April, 2026 to 31st March, 2031. Mr. S. N. Ananthasubramanian has been appointed as the scrutinizer. The voting results are expected to be announced on or by Saturday, 19th December, 2026."}, {"id": "106853645", "symbol": "HINDUNILVR", "company": "Hindustan Unilever Limited", "industry": "Diversified", "time": "2026-11-09T18:28:35", "nse_category": "Analysts/Institutional Investor Meet/Con. Call Updates", "text": "Schedule of Analyst/Investor Meet - 16.11.2026", "url": "https://nsearchives.nseindia.in/corporate/HINDUNILVR_09112026182822_09112026InvestorMeetIntimationFinalsigned.pdf", "file_size": "297.02 KB", "nse_summary": "Hindustan Unilever Limited has intimated that its management representatives will participate in the CITIC CLSA India Forum. The event is scheduled for 16th November 2026. The meeting will be conducted in physical mode. This communication is filed pursuant to Regulation 30 of the SEBI Listing Obligations